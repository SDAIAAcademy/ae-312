# Copy to .env. Only Lab 2.1 step 4 calls a model; without a key it uses the supplied outputs.
OPENROUTER_API_KEY=
# The free hosted models that play the three tiers in the live step (ids ending in :free)
MAWJ_TIER_S=liquid/lfm-3-1.7b:free
MAWJ_TIER_M=google/gemma-4-26b-a4b-it:free
MAWJ_TIER_L=google/gemma-4-31b-it:free
# 0 uses the supplied outputs even when a key is set
MAWJ_LIVE=1
# 1 makes the live step smaller
MAWJ_QUICK=0
